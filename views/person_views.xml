
<odoo>

 <!-- تعريف التقرير -->
   <record id="action_report_person_xlsx" model="ir.actions.report">
    <field name="name">Print to XLSX</field>
    <field name="model">person</field>
    <field name="report_type">xlsx</field>
    <field name="report_name">app_one.report_person_xlsx</field>
    <field name="report_file">app_one.report_person_xlsx</field>
    <field name="binding_model_id" ref="model_person"/>
    <field name="binding_type">report</field>
    <field name="attachment_use" eval="False"/>
    <field name="multi" eval="True"/> <!-- السماح بتحديد عدة سجلات -->
</record>

    <record id="view_person_form" model="ir.ui.view">
        <field name="name">person.form</field>
        <field name="model">person</field>
        <field name="arch" type="xml">
            <form string="Person">
                 <header>
                <button name="action_generate_xlsx_report"
                        string="Generate XLSX Report"
                        type="object"
                        class="btn-primary"/>
            </header>
                <sheet>
                     <div class="oe_title">
                        <label for="ref"/>
                        <h1>
                            <field name="ref"/>
                        </h1>
                        <label for="name"/>
                        <h3>
                            <field name="name" />
                        </h3>
                    </div>
                    <group>
<!--                        <field name="name"/>-->
                        <field name="birth_date"/>
                        <field name="age" readonly="1"/>
                        <field name="is_married"/>
                        <field name="confirmed_user_id"  readonly="1"/>
                        <field name="over" invisible="1"/>
                        <field name="total_gift_price"/>
                        <field name="num_children2" invisible="0" readonly="0"/>

                    </group>

                    <group  invisible="not is_married ">
                        <group>

                        <field name="spouse_name" />
                        <field name="num_children2" invisible="0" readonly="0"/>
                        <field name="spouse_birth_date" />
                        <field name="spouse_age" readonly="1"/></group>
                        <group >
                         <field name="child_n"/>
                         <field name="the_eldest_boy"/>

                        </group>
                    </group>
                    <notebook invisible="not is_married " >
                        <page string="Children"  >
                            <field name="child_ids"  >
                                <tree editable="bottom" >
                            <field name="name"/>

                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="gender"/>
                        </tree>

                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Define the tree view for the person model -->
    <record id="view_person_tree" model="ir.ui.view">
        <field name="name">person.tree</field>
        <field name="model">person</field>
        <field name="arch" type="xml">
             <tree string="Persons">
            <header>
                <!-- إضافة زر توليد تقرير XLSX -->
                <button name="action_generate_xlsx_report"
                        string="Generate XLSX Report"
                        type="object"
                        icon="fa-file-excel-o"
                        class="oe_highlight"/>
            </header>
            <field name="name"/>
                <field name="birth_date"/>
                <field name="age"/>
                <field name="is_married"/>
                <field name="total_gift_price"/>
                <!-- Optionally display spouse fields in tree view if needed -->
                <field name="spouse_name"/>
                <field name="spouse_birth_date"/>
                <field name="spouse_age"/>
            </tree>
        </field>
    </record>

    <!-- Define the action for the person model -->
    <record id="action_person" model="ir.actions.act_window">
        <field name="name">Persons</field>
        <field name="res_model">person</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_person_tree"/> <!-- Link to the tree view -->
    </record>

    <!-- Define the menu item -->
    <menuitem id="menu_person" name="Persons" action="action_person"/>
      <menuitem id="Family_menu"
              name="Family"
              parent="menu_person"
    /><!--Properties بيظهر في المنيو الي بالعرض-->
</odoo>

