<odoo>
    <record id="client_view_tree" model="ir.ui.view">
        <field name="name">Client Tree View</field>
        <field name="model">client</field>
        <field name="arch" type="xml">
            <tree>

                <field name="ok" />
            </tree>
        </field>
    </record>

    <record id="client_view_form" model="ir.ui.view">
        <field name="name">Client Form View</field>
        <field name="model">client</field>
        <field name="arch" type="xml">

             <form>
                <sheet><group string="General Info">
                        <field name="ok" />

                    </group>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>

                    <group string="General Info">
                        <field name="phone" />
                        <field name="address" />
                    </group>
                    <group>
                            <field name="property_ids" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="client_action" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">client</field>
    </record>

    <menuitem id="client_menu_item"
              name="Clients"
              parent="properties_menu"
              action="client_action" />
</odoo>
