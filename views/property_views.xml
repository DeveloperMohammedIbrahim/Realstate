<odoo>
    <!-- Tree View -->
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <tree class="header_custom" decoration-danger="(is_late)">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="postcode"/>
                <field name="active"/>
                <field name="is_late" invisible="1"/>
                <field name="selling_price"/>
                <field name="expected_price"/>
                <field name="diff_price"/>
                <field name="description"/>
                <field name="state"/>
                <field name="date" optional="1"/>
                <field name="availability" optional="1"/>
                <field name="living_area" optional="1"/>
                <field name="garden" optional="1"/>
                <field name="id" optional="1"/>
            </tree>
        </field>
    </record>
    <record id="tag_view_tree2" model="ir.ui.view">
        <field name="name">tag tree2</field>
        <field name="model">tag</field><!-- استخدام الحروف الصغيرة "tag" -->
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="property_ids"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_related_owner" type="object" icon="fa-user" string="Owner"
                                invisible="not owner_id"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-success" invisible="state != 'sold'"/>
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="action_draft" type="object" class="btn-primary" string="Set To Draft"
                                invisible="state in( 'draft' ,'closed')"/>
                        <button name="action_pending" type="object" class="btn-secondary" string="Pending"
                                invisible="state != 'draft'"/>
                        <button name="action_sold" type="object" class="btn-success" string="Sold"
                                invisible="state != 'pending'"/>
                        <button name="action" type="object" class="btn-primary" string="Action"/>
                        <button name="print_create_uid_and_user_id" type="object" class="btn-primary" string="Create "/>
                    </header>
                    <div class="oe_title">
                        <label for="ref"/>
                        <h1>
                            <field name="ref"/>
                        </h1>
                        <label for="name"/>
                        <h3>
                            <field name="name" readonly="state == 'closed'"/>
                        </h3>
                    </div>
                    <group>
                        <group string="General Info">
                            <field name="postcode" readonly="state == 'closed'"/>
                            <field name="country_id" readonly="state == 'closed'"/>
                            <field name="address_id" context="{'show_address':1}" options="{'always_reload':True}"
                                   readonly="state == 'closed'"/>
                            <field name="bedrooms" readonly="state == 'closed'"/>
                            <field name="selling_price" readonly="state in( 'draft' ,'closed')"/>
                            <field name="expected_price" readonly="state == 'closed'"/>
                            <field name="diff_price" readonly="1"/>
                            <field name="best_offer" readonly="1"/>
                            <field name="best_man" readonly="1"/>
                            <field name="active" readonly="state == 'closed'"/>
                            <field name="description" required="1"/>
                        </group>
                        <group string="Additional Info">
                            <field name="owner_id" readonly="state == 'closed'"/>
                            <field name="owner_phone" readonly="state == 'closed'"/>
                            <field name="owner_address" readonly="state == 'closed'"/>
                            <!--                            widget="many2many_tags"-->
                            <field name="tag_ids" context="{'tree_view_ref':'tag.tag_view_tree2'}"
                                   readonly="state == 'closed'"/>
                            <field name="create_time" readonly="1"/>
                            <field name="next_time" readonly="1"/>
                            <field name="date" readonly="state == 'closed'"/>
                            <field name="availability" readonly="state == 'closed'"/>
                            <field name="expected_selling_date" readonly="state == 'closed'"/>
                            <field name="is_late" readonly="state == 'closed'"/>
                            <field name="living_area" readonly="state == 'closed'"/>
                            <field name="garden" readonly="state == 'closed'"/>
                        </group>
                    </group>
                    <group>
                        <field name="garden_orientation" readonly="state == 'closed'"/>
                    </group>
                    <notebook>
                        <page string="General Information">
                            <group>
                                <field name="owner_id" context="{'active_test':False}" readonly="state == 'closed'"/>
                                <field name="owner_phone" readonly="state == 'closed'"/>
                                <field name="owner_address" readonly="state == 'closed'"/>
                                <field name="tag_ids" readonly="state == 'closed'" widget="many2many_tags"/>
                                <field name="create_time" readonly="1"/>
                                <field name="next_time" readonly="1"/>
                                <field name="date" readonly="state == 'closed'"/>
                                <field name="availability" readonly="state == 'closed'"/>
                                <field name="expected_selling_date" readonly="state == 'closed'"/>
                                <field name="is_late" readonly="state == 'closed'"/>
                                <field name="living_area" readonly="state == 'closed'"/>
                                <field name="garden" readonly="state == 'closed'"/>
                            </group>
                        </page>
                        <page string="Additional Info">
                            <group>
                                <field name="description"/>
                            </group>
                        </page>
                        <page string="Bedrooms">
                            <field name="line_ids" readonly="state == 'closed'">
                                <tree class="header_custom" editable="bottom">
                                    <field name="description"/>
                                    <field name="area"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Offers">
                            <field name="offers_ids" readonly="state in( 'sold' ,'closed')">
                                <tree editable="bottom">
                                    <field name="price"/>
                                    <field name="validity"/>
                                    <field name="partner_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <notebook>
                        <page string="Tag">
                            <field name="tag_ids">
                                <tree>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="property_view_kanban" model="ir.ui.view">
        <field name="name">property kanban</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div>
                                <field name="selling_price"/>
                            </div>
                            <div>
                                <field name="postcode"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="property_view_search" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="selling_price"/>
                <filter name="is_garden" string="With Garden" domain="[('garden', '=', True)]"/>
                <filter name="more than 50" string=">50" domain="[('expected_price', '>', 50)]"/>
                <filter name="group_garden" string="Garden" context="{'group_by':'garden'}"/>
                <filter name="greater_than_50" string=">50" context="{'group_by':'expected_price'}"/>
            </search>
        </field>
    </record>

    <!-- Action Definition -->
    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">property</field>
        <field name="context">{'default_ref':'New', 'active_test':False ,'search_default_greater_than_50':1 }</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="view_id" ref="property_view_tree"/>
    </record>
<!--    <record id="list_view_action" model="ir.actions.client">-->
<!--        <field name="name">Properties List View</field>-->
<!--        <field name="tag">property.action_list_view</field>-->
<!--    </record>-->


    <!-- Menu Item -->
    <menuitem id="property_menu_item" name="Properties" parent="properties_menu" action="property_action"/>
<!--    <menuitem-->
<!--            id="property_list_view_menu_item"-->
<!--            name="Properties OWL"-->
<!--            parent="properties_menu"-->
<!--            action="list_view_action"-->
<!--    />-->
    <!-- Server Actions -->
    <record id="property_closed_server_action" model="ir.actions.server">
        <field name="name">Closed</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            <![CDATA[
            action = records.action_closed()
            ]]>
        </field>
    </record>

    <record id="change_state_server_action" model="ir.actions.server">
        <field name="name">Open</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            <![CDATA[
            action = records.action_open_change_state_wizard()
            ]]>
        </field>
    </record>

    <!-- Scheduled Actions -->
    <record id="expected_selling_date_action" model="ir.cron">
        <field name="name">Property: Expected Selling Date</field>
        <field name="model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">model.check_expected_selling_date()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
