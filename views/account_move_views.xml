<odoo>
    <!-- تعديل عرض النموذج في Account Move -->
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">Account Move Form View Inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- تعديل التبويب Order Lines -->
            <xpath expr="//page[@name='invoice_tab']//tree/field[@name='quantity']" position="after">
                <field name="vat_amount"/>
            </xpath>
            <header>
                <!-- إضافة زر "Do Something" -->
                <button name="action_do_something" string="Do Something" type="object" class="btn-primary"/>

                <!-- إضافة زر "Print Hello Report" -->
                <!--                <button name="action_print_hello" type="object" string="Print Hello Report" class="btn-primary" />-->
                <!--                <button name="tax_invoice" type="object" string="tax_invoice" class="btn-primary" />-->
            </header>
        </field>
    </record>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">Account Move Form View Inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
<field name="partner_id" position="after">
                <field name="property_id"/>
            </field>
            <xpath expr="//page[@name='invoice_tab']" position="inside">
                <group>
                    <field name="price_total_words"/>
                </group>
            </xpath>

        </field>
    </record>


</odoo>



