<odoo>


 <record id="tag_view_tree2" model="ir.ui.view">
        <field name="name">tag tree2</field>
        <field name="model">tag</field><!-- استخدام الحروف الصغيرة "tag" -->
        <field name="arch" type="xml">
            <tree>
                <field name="name" />

            </tree>
        </field>
    </record>
 <record id="tag_view_tree" model="ir.ui.view">
        <field name="name">tag tree</field>
        <field name="model">tag</field><!-- استخدام الحروف الصغيرة "tag" -->
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="n" />
            </tree>
        </field>
    </record>
    <record id="tag_view_form" model="ir.ui.view">
        <field name="name">tag form</field>
        <field name="model">tag</field><!-- استخدام الحروف الصغيرة "tag" -->
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                 <group>
                     <field name="n" />
                     <field name="property_ids" />

                 </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="tag_action" model="ir.actions.act_window">
        <field name="name">Tag</field><!-- هذا الاسم يظهر للمستخدم -->
        <field name="res_model">tag</field><!-- استخدام الحروف الصغيرة "tag" -->
    </record>

    <menuitem id="tag_menu_item"
              name="Tags"
              parent="properties_menu"
              action="tag_action" />
</odoo>
