<odoo>

    <record id="res_partner_wizard_form" model="ir.ui.view">
        <field name="name">res partner wizard Form View</field>
        <field name="model">res.partner.wizard</field>
        <field name="arch" type="xml">
            <form>
                <footer>
<!--                    name for object just-->
                    <button name="action_generate_xlsx_report"
                        string="Generate XLSX Report"
                        type="object"
                        class="btn-primary"/>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" specail="cancel"  class="btn-secondary"/>

                </footer>
            </form>
        </field>
    </record>

    <record id="res_partner_wizard_action" model="ir.actions.act_window">
        <field name="name">res partner Wizard</field>
        <field name="res_model">res.partner.wizard</field>
        <field name="target">new</field>

        <field name="view_mode">form</field>
    </record>


</odoo>
