<odoo>
    <record id="change_state_wizard_tree" model="ir.ui.view">
        <field name="name">change state wizard Tree View</field>
        <field name="model">change.state</field>
        <field name="arch" type="xml">
            <tree>
                  <field name="property_id"  />
                            <field name="reason"  />
                            <field name="state"  />
            </tree>
        </field>
    </record>

    <record id="change_state_wizard_form" model="ir.ui.view">
        <field name="name">change state wizard Form View</field>
        <field name="model">change.state</field>
        <field name="arch" type="xml">
            <form>
                <group>
                <field name="property_id" invisible="1" />
                <field name="reason" required="1"  />
                <field name="state"  required="1" />

                </group>
                <footer>
<!--                    name for object just-->
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" specail="cancel"  class="btn-secondary"/>

                </footer>
            </form>
        </field>
    </record>

    <record id="change_state_wizard_action" model="ir.actions.act_window">
        <field name="name">Change State Wizard</field>
        <field name="res_model">change.state</field>
        <field name="target">new</field>

        <field name="view_mode">form</field>
    </record>

    <menuitem id="change_state_menu_item"
              name="Change state"
              parent="configration_menu"
              action="change_state_wizard_action" />
</odoo>
