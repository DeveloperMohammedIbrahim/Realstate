<odoo>
    <record id="view_sale_order_report_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.report.wizard.form</field>
        <field name="model">sale.order.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sale Order Report Wizard">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="partner_id"/>
                </group>
                <footer>
                    <button string="Print XLSX Report" type="object" name="print_xlsx_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_sale_order_xlsx_wizard" model="ir.actions.act_window">
        <field name="name">Sale Order XLSX Report Wizard</field>
        <field name="res_model">sale.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
