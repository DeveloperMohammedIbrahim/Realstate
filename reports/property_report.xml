<odoo>
    <data>
        <record id="property_report" model="ir.actions.report">
            <field name="name">Property Reports</field>
            <field name="model">property</field>
            <field name="report_type">qweb-html</field>
            <field name="binding_model_id" ref="app_one.model_property"/>
            <field name="binding_type">report</field>
            <field name="report_name">app_one.property_report_template</field>
        </record>

        <template id="property_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">

                    <style>
                        .property-report-table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 20px;
                            font-family: Arial, sans-serif;
                        }
                        .property-report-table th, .property-report-table td {
                            border: 1px solid #dddddd;
                            text-align: left;
                            padding: 10px;
                        }
                        .property-report-table th {
                            background-color: #f2f2f2;
                            color: #333;
                        }
                        .property-report-header {
                            text-align: center;
                            font-size: 24px;
                            font-weight: bold;
                            margin-bottom: 20px;

                        }
                    </style>

                    <h1 class="property-report-header">Property Report Info</h1>

                    <table class="property-report-table">
                        <thead>
                            <tr>
                                <th colspan="2">General Info</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Name</td>
                                <td><t t-esc="o.name"/></td>
                            </tr>
                            <tr>
                                <td>Postcode</td>
                                <td><t t-esc="o.postcode"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="property-report-table">
                        <thead>
                            <tr>
                                <th colspan="2">Additional Info</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Owner</td>
                                <td><span t-field="o.owner_id"/></td>
                            </tr>
                            <tr>
                                <td>Owner Phone</td>
                                <td><t t-esc="o.owner_phone"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="property-report-table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Area</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.line_ids" t-as="line">
                                <tr>
                                    <td><t t-esc="line.description"/></td>
                                    <td><t t-esc="line.area"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>
    </data>
</odoo>